  "config_schema": {
    "fields": [
      {
        "key": "model",
        "type": "model_picker",
        "label": "Vosk model",
        "description": "Per-language model selection. Small models are ~40 MB and fit on disk easily; full models are 1–2 GB but more accurate."
      },
      {
        "key": "auto_download",
        "type": "boolean",
        "label": "Auto-download models on first use",
        "default": true,
        "description": "When enabled, the add-on downloads the selected model from alphacephei.com the first time it's needed. Disable to require manual placement."
      }
    ]
