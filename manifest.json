  "author": "Subtitld",
  "homepage": "https://github.com/Subtitld/addon-vosk",
  "license": "Apache-2.0",
  "executable": "vosk-addon/vosk-addon",
  "protocol": 1,
  "startup_timeout_sec": 30,
  "platforms": ["linux", "macos", "windows"],
  "tasks": ["asr.transcribe"],
